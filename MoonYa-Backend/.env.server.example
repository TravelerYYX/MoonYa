# PHP server only. Never copy this environment into the desktop installation.
DB_HOST=localhost
DB_NAME=ai_system
DB_USER=
DB_PASS=
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
MAIN_API_DOMAIN=https://your-server.example
# 业务数据根（服务器必填）。默认值是「站点目录的上一级」，宝塔 open_basedir 通常不放行，必须显式指定。
# 目录须对 PHP 运行用户（宝塔默认 www）可写：chown -R www:www <路径> && chmod 700 <路径>
# 放站点目录之外时，还需把该路径加进 open_basedir 白名单并重启 php-fpm。
# 自检：php 检测脚本/data_root_check.php
MOONYA_SERVER_DATA_ROOT=/var/lib/moonya
JWT_SECRET=
ADMIN_SECRET=
API_ACCESS_KEY=
# Optional server-owned online integrations
MINMAX_TTS_API_KEY=
ALIYUN_ASR_API_KEY=
YUNZHI_API_TOKEN=
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_ENCRYPTION=tls
SMTP_CA_FILE=
# Optional server Python service for online search/crawling integrations.
# This must never point at a user's desktop Runtime.
MOONYA_PYTHON_SERVICE_URL=
# Payment keyring is stored in the database; legacy file is used only for first migration.
# 仅首次迁移旧密文时使用；数据库键环就绪后无需设置。
PAYMENT_MASTER_KEY_FILE=
# Only trust HTTPS forwarding from explicitly listed proxy addresses (no wildcard).
PAYMENT_TRUSTED_PROXIES=
# Local development only: direct loopback HTTP; always false on deployed servers.
PAYMENT_ALLOW_LOCAL_HTTP=false
# Windows service account SIDs allowed read access to the key file, comma separated.
# 仅旧文件工具使用，正常支付运行不检查 ACL。
PAYMENT_KEY_ALLOWED_SIDS=
# Legacy Alipay values: one-time admin import only; NEVER a runtime fallback.
ALIPAY_ENABLED=false
ALIPAY_ENVIRONMENT=production
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_SIGN_MODE=public_key
ALIPAY_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY_FILE=
ALIPAY_APP_CERT_FILE=
ALIPAY_CERT_FILE=
ALIPAY_ROOT_CERT_FILE=
ALIPAY_PUBLIC_URL=https://your-server.example

# Program updates: request body limits must allow one chunk (suggest 16 MiB).
MOONYA_UPDATE_CHUNK_BYTES=8388608
MOONYA_UPDATE_MAX_BYTES=2147483648
