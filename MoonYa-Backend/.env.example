# ====== MoonYa 配置文件模板 ======
# 复制本文件为 .env 并填入真实凭证:  cp .env.example .env
# .env 文件已在 .gitignore 中，不会进入版本控制

# ====== 模型 API Key ======

# Kimi / Moonshot (https://platform.moonshot.cn)
KIMI_API_KEY=

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# MinMax Chat (https://api.minimaxi.com)
MINMAX_API_KEY=

# MinMax TTS (https://api.minimaxi.com) - 语音合成
MINMAX_TTS_API_KEY=

# 智谱 GLM (https://open.bigmodel.cn)
GLM_API_KEY=

# ====== Web 附件与 Image Agent ======

IMAGE_AGENT_MODEL=kimi-k2.5
IMAGE_AGENT_TEMPERATURE=1
IMAGE_AGENT_MAX_TOKENS=4096
IMAGE_AGENT_TIMEOUT_SECONDS=180
IMAGE_AGENT_BATCH_SIZE=10
WEB_UPLOAD_MAX_FILES=100
WEB_UPLOAD_MAX_FILE_BYTES=5242880
WEB_UPLOAD_TTL_SECONDS=5400
WEB_UPLOAD_MAX_EXTRACTED_CHARS=500000
# WEB_UPLOAD_TEMP_DIR=

# ====== API 访问密钥 ======

# 后端接口的 X-API-Key 校验（客户端调用时 Header 携带）
API_ACCESS_KEY=

# ====== 独立执行守护 ======

# 可选：PHP CLI 的绝对路径。程序也会自动发现常见 Linux/宝塔/cPanel 路径；
# 无法找到时会安全回退到当前 HTTP 请求直接执行，不会中断 Agent 回复。
# 示例：/www/server/php/82/bin/php 或 /usr/bin/php
PHP_CLI_BINARY=

# ====== 第三方 API Token ======

# 云知 API（OCR / 星座 / 天气 共用同一个 token，https://yunzhiapi.cn）
YUNZHI_API_TOKEN=

# ====== SMTP 邮箱配置 ======

# SMTP 服务器（QQ 邮箱 = smtp.qq.com，163 = smtp.163.com，Gmail = smtp.gmail.com）
SMTP_HOST="smtp.qq.com"

# SMTP 端口（QQ 邮箱常用 465/587，587 走 STARTTLS）
SMTP_PORT=587

# SMTP 账号（完整邮箱地址）
SMTP_USER=

# SMTP 授权码（不是登录密码，是邮箱后台生成的"授权码/应用专用密码"）
SMTP_PASS=

# 可选发件地址（默认 SMTP_USER）、加密方式（tls 或 smtps）及私有 CA 文件路径
SMTP_FROM=
SMTP_ENCRYPTION=tls
SMTP_CA_FILE=

# ====== 数据库配置 ======

# 数据库主机
DB_HOST="localhost"

# 数据库名
DB_NAME="ai_system"

# 数据库账号
DB_USER=

# 数据库密码
DB_PASS=

# ====== JWT 签名密钥 ======

# 用于签发 / 校验 JWT token，**泄露后可以伪造任意用户身份**
# 建议生产环境用 32+ 字符随机串（可执行：openssl rand -hex 32）
# 注意：admin/Auth.php 读的是 admin/config.php，与主 config.php 共用此 env
JWT_SECRET=

# 仅本机开发可设为 true；只允许 localhost/127.0.0.1/[::1] 的直接回环 HTTP。
# 正式部署保持 false，HTTPS、同源校验及管理员身份复验仍是必需项。
PAYMENT_ALLOW_LOCAL_HTTP=false

# ====== Admin 后台密钥 ======

# admin/config.php 的 admin_secret（用于后台某些管理操作签名 / 接口校验）
# 泄露后可绕过部分后台校验，建议同样用随机串
ADMIN_SECRET=
