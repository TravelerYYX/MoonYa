/MoonYa-Backend/SQL/ai_system_full_mysql8_*.sql
/MoonYa-Backend/SQL/ai_system_baota_import.sql
/MoonYa-Backend/SQL/ai_system_opensource_2026-*.sql
/MoonYa-Backend/sql/ai_system_full_mysql8_*.sql
/MoonYa-Backend/sql/ai_system_baota_import.sql

# phpMyAdmin 导出的旧全量备份（2026-08-09，含 users/admins/admin_login_tokens 真实数据）
/MoonYa-Backend/SQL/数据库.sql
/MoonYa-Backend/SQL/数据库*.sql

