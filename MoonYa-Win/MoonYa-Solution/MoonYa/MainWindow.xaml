<Window x:Class="MoonYa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MoonYa"
        xmlns:cef="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
        Title="MoonYa"
        Width="1440" Height="820"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MainWindowStyle}"
        WindowStyle="SingleBorderWindow"
        Background="Transparent"
        ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      CornerRadius="8"
                      ResizeBorderThickness="6"
                      CaptionHeight="32"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ── Title-bar button style (light) ────── -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushTitleBarBtnHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Title-bar action button (sidebar toggle / new chat) ────── -->
        <Style x:Key="TitleBarIconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="hit"
                                Background="{TemplateBinding Background}"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hit" Property="Background" Value="{DynamicResource BrushTitleBarBtnHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Title-bar pill item (operation detail / voice toggle) ──────
             纯图标：不画任何底色（含激活态与悬停态），保证标题栏上没有色块 -->
        <Style x:Key="TitleBarPillItemButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="item"
                                Background="Transparent"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════ -->
    <!--  ROOT LAYOUT                                         -->
    <!-- ══════════════════════════════════════════════════════ -->
    <Border x:Name="RootBorder"
            Background="{DynamicResource BrushBgDark}"
            CornerRadius="8"
            BorderBrush="{DynamicResource BrushBorderDefault}"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ── TITLE BAR (white) ──────────────────────── -->
            <Grid x:Name="TitleBarGrid"
                  Grid.Row="0"
                  Panel.ZIndex="100"
                  Background="Transparent"
                  Visibility="Collapsed"
                  Height="32"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 折叠侧边栏 + 新建对话：从左侧挪到标题栏，矢量图标，直接驱动网页内的左侧边栏 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="6,0,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- 折叠 / 展开侧边栏 -->
                    <Button x:Name="SidebarToggleBtn"
                            Style="{StaticResource TitleBarIconButton}"
                            Click="ToggleSidebar_Click" ToolTip="折叠侧边栏">
                        <Canvas Width="16" Height="16">
                            <Rectangle Canvas.Left="1" Canvas.Top="1"
                                       Width="14" Height="14"
                                       RadiusX="3.2" RadiusY="3.2"
                                       Stroke="{DynamicResource BrushTitleBarText}" StrokeThickness="1.4"
                                       Fill="Transparent" />
                            <Line X1="5.8" Y1="1" X2="5.8" Y2="15"
                                  Stroke="{DynamicResource BrushTitleBarText}" StrokeThickness="1.4" />
                        </Canvas>
                    </Button>
                    <!-- 新建对话 -->
                    <Button x:Name="NewChatBtn"
                            Style="{StaticResource TitleBarIconButton}"
                            Click="NewChat_Click" ToolTip="新建对话">
                        <Canvas Width="16" Height="16">
                            <Path Stroke="{DynamicResource BrushTitleBarText}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Fill="Transparent"
                                  Data="M 5.267,13.333 A 6,6 0 1 0 2.667,10.733 L 1.333,14.667 Z" />
                            <Path Stroke="{DynamicResource BrushTitleBarText}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 5.8,8 H 10.2 M 8,5.8 V 10.2" />
                        </Canvas>
                    </Button>
                </StackPanel>

                <!-- Window controls — vector-drawn icons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- 操作详情 + 语音播报：从页面右上角挪到最小化左边，矢量图标。
                         不画底色也不画边框，直接融进标题栏，只用按钮自身的圆形底色表达激活态。 -->
                    <Border Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="1"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <!-- 折叠侧边栏（第二入口，常驻右侧方便单手操作）。
                                 右侧工作面板已随 Harness 化重构在服务端移除 DOM，
                                 原「操作详情」按钮无处可开，改为与标题栏左侧一致的折叠语义 -->
                            <Button x:Name="DetailToggleBtn"
                                    Style="{StaticResource TitleBarPillItemButton}"
                                    Click="ToggleDetail_Click" ToolTip="展开操作详情">
                                <Canvas Width="16" Height="16">
                                    <Rectangle Canvas.Left="1" Canvas.Top="1"
                                               Width="14" Height="14"
                                               RadiusX="3.2" RadiusY="3.2"
                                               Stroke="{DynamicResource BrushTitleBarText}" StrokeThickness="1.4"
                                               Fill="Transparent" />
                                    <Line X1="5.8" Y1="1" X2="5.8" Y2="15"
                                          Stroke="{DynamicResource BrushTitleBarText}" StrokeThickness="1.4" />
                                </Canvas>
                            </Button>
                            <!-- 语音播报开关（仅 Chat 模式显示；页面默认 Work，故初始折叠，加载后按模式同步）。
                                 与「操作详情」之间不留分隔线，只用间距分开 -->
                            <Button x:Name="VoiceToggleBtn"
                                    Margin="4,0,0,0"
                                    Visibility="Collapsed"
                                    Style="{StaticResource TitleBarPillItemButton}"
                                    Click="ToggleVoice_Click" ToolTip="关闭语音播报">
                                <Grid Width="16" Height="16">
                                    <Canvas x:Name="VoiceOnIcon" Width="16" Height="16">
                                        <Path Stroke="{DynamicResource BrushAccentWarm}" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Fill="Transparent"
                                              Data="M 11.65,3.89 A 5.5,5.5 0 1 0 11.65,12.11" />
                                        <Path Stroke="{DynamicResource BrushAccentWarm}" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 5.5,6.8 V 9.2 M 8,5.6 V 10.4 M 10.5,6.8 V 9.2" />
                                    </Canvas>
                                    <Canvas x:Name="VoiceOffIcon" Width="16" Height="16"
                                            Visibility="Collapsed">
                                        <Path Stroke="{DynamicResource BrushTitleBarText}" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Fill="Transparent"
                                              Data="M 11.65,3.89 A 5.5,5.5 0 1 0 11.65,12.11" />
                                        <Path Stroke="{DynamicResource BrushTitleBarText}" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 5.5,6.8 V 9.2 M 8,5.6 V 10.4 M 10.5,6.8 V 9.2" />
                                    </Canvas>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Minimize -->
                    <Button Style="{StaticResource TitleBarButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Minimize_Click" ToolTip="最小化">
                        <Canvas Width="10" Height="10">
                            <Line X1="1" Y1="7" X2="9" Y2="7"
                                  Stroke="{DynamicResource BrushTitleBarText}" StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Button>

                    <!-- Maximize / Restore -->
                    <Button x:Name="MaxRestoreBtn"
                            Style="{StaticResource TitleBarButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MaximizeRestore_Click" ToolTip="最大化">
                        <Grid Width="10" Height="10">
                            <!-- Maximize: single square -->
                            <Canvas x:Name="MaxCanvas" Visibility="Visible">
                                <Rectangle Width="8" Height="8"
                                           Canvas.Left="1" Canvas.Top="1"
                                           Stroke="{DynamicResource BrushTitleBarText}" StrokeThickness="1.2"
                                           Fill="Transparent" />
                            </Canvas>
                            <!-- Restore: two overlapping squares -->
                            <Canvas x:Name="RestoreCanvas" Visibility="Collapsed">
                                <Rectangle Width="6" Height="6"
                                           Canvas.Left="3" Canvas.Top="1"
                                           Stroke="{DynamicResource BrushTitleBarText}" StrokeThickness="1.2"
                                           Fill="Transparent" />
                                <Rectangle Width="6" Height="6"
                                           Canvas.Left="1" Canvas.Top="3"
                                           Stroke="{DynamicResource BrushTitleBarText}" StrokeThickness="1.2"
                                           Fill="Transparent" />
                            </Canvas>
                        </Grid>
                    </Button>

                    <!-- Close -->
                    <Button Style="{StaticResource CloseButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Close_Click" ToolTip="关闭"
                            MouseEnter="CloseBtn_MouseEnter"
                            MouseLeave="CloseBtn_MouseLeave">
                        <Canvas Width="10" Height="10">
                            <Line x:Name="CloseLine1" X1="1" Y1="1" X2="9" Y2="9"
                                  Stroke="{DynamicResource BrushTitleBarText}" StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line x:Name="CloseLine2" X1="9" Y1="1" X2="1" Y2="9"
                                  Stroke="{DynamicResource BrushTitleBarText}" StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Button>
                </StackPanel>

            </Grid>

            <!-- ── WEBVIEW AREA ───────────────────────────── -->
            <!-- 背景与 WebView 覆盖两行，标题栏叠在其上；页面为内容保留标题栏空间。 -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource BrushBgDark}">
                <Rectangle x:Name="AppearanceBackgroundVideo"
                           IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="Collapsed" />
                <local:CustomChromiumWebBrowser x:Name="WebView"
                                        Focusable="True"
                                        IsTabStop="True"
                                        KeyboardNavigation.TabNavigation="Once"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"
                                        GotFocus="WebView_GotFocus"
                                        LostFocus="WebView_LostFocus"
                                        PreviewMouseDown="WebView_PreviewMouseDown"
                                        PreviewMouseUp="WebView_PreviewMouseUp" />

                <!-- ── LOADING OVERLAY ────────────────────── -->
                <Grid x:Name="LoadingOverlay"
                      Background="{DynamicResource BrushBgDark}"
                      Visibility="Visible">

                    <!-- 自定义启动画面背景：作为子层叠加，而不是覆盖 Grid 自己的 Background。
                         一旦给 Background 赋本地值，DynamicResource 引用会被替换掉，明暗主题切换就永久失灵。 -->
                    <Image x:Name="LoadingOverlayImage"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="Collapsed" />
                    <!-- 自定义启动画面视频：同样作为子层（不碰 Grid.Background），
                         由 Media Foundation 原生播放 —— 页面内 <video> 解不了 H.264。
                         放在 Scrim 之前，好让压暗层同样作用在视频上。 -->
                    <Rectangle x:Name="LoadingOverlayVideo"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="Collapsed" />
                    <!-- 有自定义背景时压一层遮罩，保证「MoonYa / 正在启动MoonYa」可读 -->
                    <Border x:Name="LoadingOverlayScrim"
                            Background="{DynamicResource BrushBgDark}"
                            Opacity="0.55"
                            Visibility="Collapsed" />

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextBlock.TextAlignment="Center">

                        <TextBlock Text="MoonYa"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   FontFamily="Segoe UI, Segoe UI Variable, system-ui, sans-serif"
                                   Margin="0,0,0,28" />

                        <!-- Rounded black progress bar -->
                        <ProgressBar x:Name="LoadingProgressBar"
                                     IsIndeterminate="True"
                                     Width="280"
                                     Height="6"
                                     Margin="0,0,0,32">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Grid>
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Determinate" />
                                                            <VisualState x:Name="Indeterminate">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <!-- Position: 0 → 160 → 0 -->
                                                                    <DoubleAnimationUsingKeyFrames
                                                                        Storyboard.TargetName="PART_Indicator"
                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                                                        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="160">
                                                                            <EasingDoubleKeyFrame.EasingFunction>
                                                                                <CubicEase EasingMode="EaseInOut" />
                                                                            </EasingDoubleKeyFrame.EasingFunction>
                                                                        </EasingDoubleKeyFrame>
                                                                        <EasingDoubleKeyFrame KeyTime="0:0:1.6" Value="0">
                                                                            <EasingDoubleKeyFrame.EasingFunction>
                                                                                <CubicEase EasingMode="EaseInOut" />
                                                                            </EasingDoubleKeyFrame.EasingFunction>
                                                                        </EasingDoubleKeyFrame>
                                                                    </DoubleAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                    <Border Background="{DynamicResource BrushBgSurface}"
                                                            CornerRadius="4"
                                                            BorderThickness="0"
                                                            ClipToBounds="True" />
                                                    <Border x:Name="PART_Indicator"
                                                            CornerRadius="4"
                                                            HorizontalAlignment="Left"
                                                            Width="120"
                                                            RenderTransformOrigin="0,0.5">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="Transparent" Offset="0.0" />
                                                                <GradientStop Color="{DynamicResource LoadingSweepSoft}" Offset="0.25" />
                                                                <GradientStop Color="{DynamicResource LoadingSweep}" Offset="0.5" />
                                                                <GradientStop Color="{DynamicResource LoadingSweepSoft}" Offset="0.75" />
                                                                <GradientStop Color="Transparent" Offset="1.0" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.RenderTransform>
                                                            <TranslateTransform />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Text="正在启动MoonYa"
                                   FontSize="12"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   FontFamily="Segoe UI, Segoe UI Variable, system-ui, sans-serif"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="FrontendStartupError" Visibility="Collapsed" Panel.ZIndex="70"
                            Background="{DynamicResource BrushBgDark}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                    <TextBlock x:Name="FrontendStartupErrorText" TextWrapping="Wrap" Margin="20" />
                    <Button Content="重试启动本地界面" Click="RetryFrontendStartup" Margin="20" Padding="12,8" />
                </StackPanel>
                <!-- ── 内置浏览器覆盖层（右侧栏面板，CEF 控件由代码懒创建）── -->
                <Canvas x:Name="BuiltinBrowserLayer"
                        Panel.ZIndex="60"
                        Visibility="Collapsed" />
                <local:CustomChromiumWebBrowser x:Name="LegacyMigrationBrowser" Width="1" Height="1"
                    Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Grid>
        </Grid>
    </Border>
</Window>
