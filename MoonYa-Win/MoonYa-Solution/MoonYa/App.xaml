<Application x:Class="MoonYa.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ── Title-bar (white / light) ──────────── -->
            <Color x:Key="TitleBarBg">#F4F3F5</Color>
            <Color x:Key="TitleBarText">#26272B</Color>
            <Color x:Key="TitleBarSubText">#8A8A90</Color>
            <Color x:Key="TitleBarBtnHover">#E6E6E6</Color>
            <Color x:Key="TitleBarBtnCloseHover">#C42B1C</Color>

            <!-- ── Loading / main area (light) ─────────── -->
            <Color x:Key="BgDark">#FFFFFF</Color>
            <Color x:Key="BgMid">#F5F5F5</Color>
            <Color x:Key="BgSurface">#EEEEEE</Color>
            <Color x:Key="BgElevated">#E8E8E8</Color>
            <Color x:Key="BorderSubtle">#E5E4E8</Color>
            <Color x:Key="BorderDefault">#D1D1D1</Color>
            <Color x:Key="TextPrimary">#1A1A1A</Color>
            <Color x:Key="TextSecondary">#6B6B6B</Color>
            <Color x:Key="TextMuted">#9A9A9A</Color>
            <Color x:Key="AccentWarm">#3B82F6</Color>
            <Color x:Key="AccentWarmHover">#2563EB</Color>
            <Color x:Key="AccentGreen">#5B9A6B</Color>
            <Color x:Key="AccentRed">#C85050</Color>
            <Color x:Key="AccentAmber">#D4943C</Color>

            <!-- ── Brushes ─────────────────────────────── -->
            <SolidColorBrush x:Key="BrushTitleBarBg" Color="{DynamicResource TitleBarBg}" />
            <SolidColorBrush x:Key="BrushTitleBarText" Color="{DynamicResource TitleBarText}" />
            <SolidColorBrush x:Key="BrushTitleBarSubText" Color="{DynamicResource TitleBarSubText}" />
            <SolidColorBrush x:Key="BrushTitleBarBtnHover" Color="{DynamicResource TitleBarBtnHover}" />
            <SolidColorBrush x:Key="BrushBgDark" Color="{DynamicResource BgDark}" />
            <SolidColorBrush x:Key="BrushBgMid" Color="{DynamicResource BgMid}" />
            <SolidColorBrush x:Key="BrushBgSurface" Color="{DynamicResource BgSurface}" />
            <SolidColorBrush x:Key="BrushBgElevated" Color="{DynamicResource BgElevated}" />
            <SolidColorBrush x:Key="BrushBorderSubtle" Color="{DynamicResource BorderSubtle}" />
            <SolidColorBrush x:Key="BrushBorderDefault" Color="{DynamicResource BorderDefault}" />
            <SolidColorBrush x:Key="BrushTextPrimary" Color="{DynamicResource TextPrimary}" />
            <SolidColorBrush x:Key="BrushTextSecondary" Color="{DynamicResource TextSecondary}" />
            <SolidColorBrush x:Key="BrushTextMuted" Color="{DynamicResource TextMuted}" />
            <SolidColorBrush x:Key="BrushAccentWarm" Color="{DynamicResource AccentWarm}" />
            <SolidColorBrush x:Key="BrushAccentGreen" Color="{DynamicResource AccentGreen}" />

            <!-- ── Global Styles ───────────────────────── -->
            <Style TargetType="ToolTip">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Background" Value="#252628" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="MaxWidth" Value="360" />
                <Setter Property="HasDropShadow" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}" CornerRadius="10"
                                    Margin="8" MaxWidth="{TemplateBinding MaxWidth}">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="12"
                                                      ShadowDepth="4" Opacity="0.18" />
                                </Border.Effect>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}">
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                       LineHeight="18" LineStackingStrategy="BlockLineHeight" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Window" x:Key="MainWindowStyle">
                <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, system-ui, sans-serif" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, system-ui, sans-serif" />
            </Style>

            <Style x:Key="StatusText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, system-ui, sans-serif" />
            </Style>

            <Style x:Key="LoadingText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, system-ui, sans-serif" />
            </Style>

            <Style x:Key="TitleBarTitleText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource BrushTitleBarText}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, system-ui, sans-serif" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
