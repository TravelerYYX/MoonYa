{
  "name": "@moonya/harness-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process MoonYa Agent Runtime SDK clients",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/moonya-agent-runtime.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@moonya/harness-brand": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@moonya/harness-agent": "workspace:^",
    "@moonya/harness-attachment": "workspace:^",
    "@moonya/harness-llm": "workspace:^",
    "@moonya/harness-llm-deepseek": "workspace:^",
    "@moonya/harness-scope": "workspace:^",
    "@moonya/harness-sdk-protocol": "workspace:^",
    "@moonya/harness-session": "workspace:^",
    "@moonya/harness-subagent": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@moonya/harness-agent": "workspace:^",
    "@moonya/harness-agent-loop": "workspace:^",
    "@moonya/harness-agent-loop-testkit": "workspace:^",
    "@moonya/harness-attachment": "workspace:^",
    "@moonya/harness-llm": "workspace:^",
    "@moonya/harness-llm-deepseek": "workspace:^",
    "@moonya/harness-scope": "workspace:^",
    "@moonya/harness-sdk-protocol": "workspace:^",
    "@moonya/harness-session": "workspace:^",
    "@moonya/harness-session-persistence-jsonl": "workspace:^",
    "@moonya/harness-session-projection": "workspace:^",
    "@moonya/harness-subagent": "workspace:^"
  }
}
