{
  "name": "@moonya/harness-goal-round-driver",
  "description": "Race-fenced same-session goal-round driver",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/moonya-agent-runtime.git",
    "directory": "packages/goal/goal-round-driver"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@moonya/harness-agent": "workspace:^",
    "@moonya/harness-goal": "workspace:^",
    "@moonya/harness-invariants": "workspace:^",
    "@moonya/harness-llm": "workspace:^",
    "@moonya/harness-session": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@moonya/harness-agent": "workspace:^",
    "@moonya/harness-agent-loop": "workspace:^",
    "@moonya/harness-agent-loop-testkit": "workspace:^",
    "@moonya/harness-goal": "workspace:^",
    "@moonya/harness-invariants": "workspace:^",
    "@moonya/harness-llm": "workspace:^",
    "@moonya/harness-session": "workspace:^",
    "@moonya/harness-system-prompt": "workspace:^",
    "@moonya/harness-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@moonya/harness-session-projection": "workspace:^"
  }
}
