{
  "name": "@moonya/harness-sandbox-local",
  "description": "Local process-sandbox backends for the MoonYa Agent Runtime sandbox seam: bwrap, the npm-distributed landlock-run launcher, macOS Seatbelt, or the Windows ACL restricted-token runner — functionally probed, fail-closed",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/moonya-agent-runtime.git",
    "directory": "packages/sandbox/sandbox-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@moonya/harness-llm": "workspace:^",
    "@moonya/harness-sandbox": "workspace:^",
    "@moonya/harness-session": "workspace:^"
  },
  "dependencies": {
    "@moonya/harness-sandbox-windows-acl": "workspace:^",
    "@moonya/harness-util-values": "workspace:^",
    "@deepseek-ai/node-addon-system": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@moonya/harness-llm": "workspace:^",
    "@moonya/harness-sandbox": "workspace:^",
    "@moonya/harness-session": "workspace:^"
  }
}
