{
  "name": "@moonya/harness-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/moonya-agent-runtime.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@moonya/harness-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@moonya/harness-deque": "workspace:^",
    "@moonya/harness-session": "workspace:^",
    "@moonya/harness-util-values": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@moonya/harness-scope": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@moonya/harness-agent": "workspace:^",
    "@moonya/harness-agent-presets": "workspace:^",
    "@moonya/harness-api-gateway": "workspace:^",
    "@moonya/harness-api-settings-controller": "workspace:^",
    "@moonya/harness-api-workspace-controller": "workspace:^",
    "@moonya/harness-commands": "workspace:^",
    "@moonya/harness-cordis-host-runner": "workspace:^",
    "@moonya/harness-credentials": "workspace:^",
    "@moonya/harness-file-reference": "workspace:^",
    "@moonya/harness-goal": "workspace:^",
    "@moonya/harness-host-plugin-inventory": "workspace:^",
    "@moonya/harness-llm": "workspace:^",
    "@moonya/harness-message-feedback": "workspace:^",
    "@moonya/harness-session-reference": "workspace:^",
    "@moonya/harness-settings": "workspace:^",
    "@moonya/harness-subagent": "workspace:^",
    "@moonya/harness-user-approval": "workspace:^",
    "@moonya/harness-user-questions": "workspace:^",
    "@moonya/harness-client-connection": "workspace:^",
    "@moonya/harness-client-file-upload": "workspace:^",
    "@moonya/harness-typert-protocol": "workspace:^",
    "@moonya/harness-scope": "workspace:^",
    "@moonya/harness-api-session-controller": "workspace:^",
    "@moonya/harness-api-workspace-files": "workspace:^",
    "zod": "^4.4.3",
    "@moonya/harness-command-feedback": "workspace:^"
  }
}
