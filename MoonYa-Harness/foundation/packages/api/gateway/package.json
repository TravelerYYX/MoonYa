{
  "name": "@moonya/harness-api-gateway",
  "description": "Typert Remote Host dispatcher and Client API endpoint",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/moonya-agent-runtime.git",
    "directory": "packages/api/gateway"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@moonya/harness-typert-registry",
        "@moonya/harness-client-connection"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@moonya/harness-deque": "workspace:^",
    "@moonya/harness-timeout": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "ws": "^8.21.0",
    "@moonya/harness-typert-protocol": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@moonya/harness-brand": "workspace:^",
    "@moonya/harness-client-connection": "workspace:^",
    "@moonya/harness-host-webserver": "workspace:^",
    "@moonya/harness-typert-registry": "workspace:^",
    "@moonya/harness-util-crypto": "workspace:^",
    "@types/ws": "^8.18.1",
    "@deepseek-ai/cordis": "workspace:^",
    "zod": "^4.4.3"
  }
}
