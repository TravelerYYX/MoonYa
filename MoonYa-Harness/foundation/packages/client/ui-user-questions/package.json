{
  "name": "@moonya/harness-client-ui-user-questions",
  "description": "Web ask_user_question composer takeover and plan-review presentation UI",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/moonya-agent-runtime.git",
    "directory": "packages/client/ui-user-questions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@moonya/harness-api-remotes",
        "@moonya/harness-api-session-controller",
        "@moonya/harness-client-locale",
        "@moonya/harness-client-ui-conversation",
        "@moonya/harness-client-ui-renderer",
        "@moonya/harness-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@moonya/harness-agent": "workspace:^",
    "@moonya/harness-api-remotes": "workspace:^",
    "@moonya/harness-api-session-controller": "workspace:^",
    "@moonya/harness-client-locale": "workspace:^",
    "@moonya/harness-client-store": "workspace:^",
    "@moonya/harness-system-prompt": "workspace:^",
    "@moonya/harness-tools": "workspace:^",
    "@moonya/harness-user-questions": "workspace:^",
    "@types/react": "~18.3.1",
    "@moonya/harness-client-ui-primitives": "workspace:^",
    "@moonya/harness-client-ui-slots": "workspace:^",
    "@moonya/harness-client-ui-renderer": "workspace:^",
    "@moonya/harness-client-ui-session": "workspace:^",
    "@moonya/harness-typert-protocol": "workspace:^",
    "react": "^18.2.0",
    "@moonya/harness-client-ui-conversation": "workspace:^",
    "@moonya/harness-client-connection": "workspace:^",
    "@moonya/harness-session": "workspace:^",
    "clsx": "^2.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
