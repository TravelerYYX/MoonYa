{
  "name": "@moonya/harness-client-file-upload",
  "description": "Agent-scoped browser file upload, streaming intake, and staged receipt service",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/moonya-agent-runtime.git",
    "directory": "packages/client/file-upload"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@moonya/harness-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "zod": "^4.4.3",
    "@moonya/harness-typert-protocol": "workspace:^",
    "@moonya/harness-brand": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@moonya/harness-scope": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@moonya/harness-agent": "workspace:^",
    "@moonya/harness-client-connection": "workspace:^",
    "@moonya/harness-commands": "workspace:^",
    "@moonya/harness-scope": "workspace:^",
    "@moonya/harness-util-crypto": "workspace:^",
    "@moonya/harness-api-remotes": "workspace:^",
    "@moonya/harness-session": "workspace:^",
    "@moonya/harness-attachment": "workspace:^"
  }
}
