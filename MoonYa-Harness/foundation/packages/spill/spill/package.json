{
  "name": "@moonya/harness-spill",
  "description": "Abstract spill storage seam (ctx.spillStore) for the MoonYa Agent Runtime — save oversized tool text and return a retrieval locator",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/moonya-agent-runtime.git",
    "directory": "packages/spill/spill"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@moonya/harness-brand": "workspace:^",
    "@moonya/harness-llm": "workspace:^",
    "@moonya/harness-session": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@moonya/harness-brand": "workspace:^",
    "@moonya/harness-llm": "workspace:^",
    "@moonya/harness-session": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
