{
  "name": "@moonya/harness-pwsh-sandbox",
  "description": "Sandbox-consuming implementation of the MoonYa Agent Runtime PowerShell executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/moonya-agent-runtime.git",
    "directory": "packages/shell/pwsh-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@moonya/harness-shell": "workspace:^",
    "@moonya/harness-pwsh-local": "workspace:^",
    "@moonya/harness-sandbox": "workspace:^",
    "@moonya/harness-sandbox-policy": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@moonya/harness-shell": "workspace:^",
    "@moonya/harness-pwsh-local": "workspace:^",
    "@moonya/harness-sandbox": "workspace:^",
    "@moonya/harness-sandbox-local": "workspace:^",
    "@moonya/harness-sandbox-policy": "workspace:^",
    "@moonya/harness-session-projection": "workspace:^",
    "@moonya/harness-subprocess-local": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
