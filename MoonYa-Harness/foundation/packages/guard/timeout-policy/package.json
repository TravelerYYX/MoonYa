{
  "name": "@moonya/harness-tool-call-timeout-policy",
  "description": "Tool-call timeout policy: a tools/execute wrapper that arms a per-tool deadline on exec.signal and returns TOOL_TIMEOUT when it wins",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/moonya-agent-runtime.git",
    "directory": "packages/guard/timeout-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@moonya/harness-llm": "workspace:^",
    "@moonya/harness-timeout": "workspace:^",
    "@moonya/harness-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@moonya/harness-llm": "workspace:^",
    "@moonya/harness-timeout": "workspace:^",
    "@moonya/harness-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
